{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/main.tsx", "src/App.tsx", "src/components/**/*.tsx", "src/lib/**/*.ts", "vite.config.ts"],
  "exclude": ["src/worker.ts", "src/auth.ts", "src/providers.ts", "src/api.ts"]
}
