{
  "name": "@photointel/manage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run tsc7 -- -p tsconfig.json --noEmit && npm run tsc7 -- -p tsconfig.worker.json --noEmit && vite build",
    "typecheck": "node scripts/typecheck-all.mjs",
    "lint": "eslint src vite.config.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src && npm run test:pwa",
    "format": "npm --prefix ../.. run format:manage",
    "format:check": "npm --prefix ../.. run format:check:manage",
    "postbuild": "node scripts/inject-precache.mjs",
    "test:pwa": "node --test scripts/offline-sw.test.mjs",
    "tsc7": "node node_modules/@typescript/native/bin/tsc",
    "generate:api": "openapi-ts",
    "prebuild": "npm run generate:api",
    "pretypecheck": "npm run generate:api"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.43.15",
    "@hookform/resolvers": "^7.0.0",
    "@lezer/highlight": "^1.2.1",
    "@module-federation/enhanced": "2.9.4",
    "@module-federation/vite": "1.25.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.3",
    "@rodkisten/photointel": "file:../../packages/env",
    "@rodverse/module-sdk": "file:../../packages/rod-module-sdk",
    "@sentry/react": "^11.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-virtual": "^3.13.12",
    "@wterm/dom": "0.5.10",
    "@wterm/ghostty": "0.5.10",
    "@wterm/react": "0.5.10",
    "@xyflow/react": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dexie": "^4.2.0",
    "js-yaml": "^5.0.0",
    "lucide-react": "^1.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.63.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "^1.55.1",
    "@sentry/vite-plugin": "^11.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^17.0.0",
    "jsdom": "^31.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^8.0.0",
    "vitest": "^5.0.4"
  }
}
