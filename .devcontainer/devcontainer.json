{
  "name": "Photo Intelligence Cloud",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {"version": "22"},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "remoteUser": "vscode",
  "forwardPorts": [5173, 8000, 9001],
  "portsAttributes": {
    "5173": {"label": "Photo Intelligence", "onAutoForward": "notify"},
    "8000": {"label": "API privada", "onAutoForward": "silent"},
    "9001": {"label": "MinIO local", "onAutoForward": "silent"}
  },
  "postCreateCommand": "python -m pip install uv==0.12.23 && make setup",
  "customizations": {"vscode": {"extensions": ["ms-python.python", "charliermarsh.ruff", "dbaeumer.vscode-eslint"]}}
}
