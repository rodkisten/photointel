# Rod Mobile Zsh: designed for a small, touch-operated Codespaces terminal.
# Keep this file fast: no network requests, installers or language managers.

export PATH="$HOME/.local/bin:$PATH"
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="rod-mobile"
ZSH_CUSTOM="$ZSH/custom"
zstyle ':omz:update' mode disabled
DISABLE_AUTO_TITLE="true"
DISABLE_MAGIC_FUNCTIONS="true"
DISABLE_UNTRACKED_FILES_DIRTY="true"
ENABLE_CORRECTION="false"  # Use native CORRECT below, without a second OMZ layer.

# OMZ completion and Git/Cloudflare/Google Cloud helpers.
# syntax-highlighting must remain last to see the final ZLE widget bindings.
plugins=(
  git
  gh
  gcloud
  docker
  kubectl
  colored-man-pages
  colorize
  extract
  sudo
  command-not-found
  zsh-completions
  zsh-autosuggestions
  zsh-syntax-highlighting
)
# Register additional completion definitions before OMZ initializes compinit.
fpath=("$ZSH_CUSTOM/plugins/zsh-completions/src" $fpath)
source "$ZSH/oh-my-zsh.sh"

# Error-tolerant defaults, without silently altering filenames or commands.
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS EXTENDED_GLOB
setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_FIND_NO_DUPS HIST_REDUCE_BLANKS
setopt SHARE_HISTORY INC_APPEND_HISTORY
setopt CORRECT
unsetopt CORRECT_ALL BEEP
SPROMPT='Corrigir %F{red}%R%f para %F{green}%r%f? [y/n/e/a] '
WORDCHARS=${WORDCHARS//\/}  # Make slash a word boundary for easier path edits.

HISTFILE="$HOME/.zsh_history"
HISTSIZE=20000
SAVEHIST=20000
DIRSTACKSIZE=12
export PAGER='less -FRX'
export GIT_PAGER='less -FRX'
export LESS='-FRX'
export LESSHISTFILE=-
export CLICOLOR=1
export EDITOR=micro
export VISUAL=micro
export PYTHONUTF8=1
export UV_NO_PROGRESS=1

# Completion menu is navigable from arrow keys; avoid per-keystroke cloud calls.
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}%d%f'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$HOME/.cache/zsh-completion"
mkdir -p "$HOME/.cache/zsh-completion"

# Legible suggestion/flag/path colors on a mobile-width terminal.
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=244'
ZSH_AUTOSUGGEST_STRATEGY=(history)
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=120
ZSH_HIGHLIGHT_STYLES[command]='fg=green,bold'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=green'
ZSH_HIGHLIGHT_STYLES[function]='fg=green'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=red,bold'
ZSH_HIGHLIGHT_STYLES[single-hyphen-option]='fg=cyan'
ZSH_HIGHLIGHT_STYLES[double-hyphen-option]='fg=cyan,bold'
ZSH_HIGHLIGHT_STYLES[path]='fg=blue,underline'
ZSH_HIGHLIGHT_STYLES[globbing]='fg=magenta'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=yellow'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=yellow'

# Emacs-style text navigation; compatible with Codespaces' xterm.js.
bindkey -e
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[3~' delete-char
bindkey '^[b' backward-word
bindkey '^[f' forward-word
bindkey '^W' backward-kill-word
bindkey '^U' backward-kill-line
bindkey '^A' beginning-of-line
bindkey '^E' end-of-line

# Colored everyday tools. Retain normal 'cat' for scripts/pipes.
if (( $+commands[eza] )); then
  alias ls='eza --group-directories-first --color=auto'
  alias ll='eza -lah --group-directories-first --color=auto'
  alias la='eza -a --group-directories-first --color=auto'
  alias lt='eza --tree --level=2 --group-directories-first'
else
  alias ll='ls -lah'
  alias la='ls -a'
  alias lt='ls -R'
fi
if (( $+commands[batcat] )); then alias c='batcat --paging=never'; fi
if (( $+commands[bat] )); then alias c='bat --paging=never'; fi
if (( $+commands[fdfind] )); then alias fd='fdfind'; fi
if (( $+commands[rg] )); then alias rg='rg --smart-case'; fi
alias jpp='jq -C .'
alias ports='ss -tulpen'
alias py='python'
alias pip='uv pip'
alias venv='uv venv'
alias wr='wrangler'

# Native quick commands that work even when Ctrl+R or function keys are hidden.
function croot() { cd "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"; }
function up() {
  local n="${1:-1}"
  if [[ "$n" != <-> ]] || (( n < 1 || n > 30 )); then
    print -u2 'Uso: up [1..30]'
    return 2
  fi
  local i
  for (( i=0; i<n; i++ )); do cd .. || return; done
}
function mkcd() { mkdir -p -- "$1" && cd -- "$1"; }
function ff() {
  if (( $+commands[fdfind] )); then fdfind --hidden --exclude .git "${@:-.}"
  elif (( $+commands[fd] )); then command fd --hidden --exclude .git "${@:-.}"
  else print -u2 "fd/fdfind não encontrado"; return 127; fi
}
function fcd() {
  local target
  if (( $+commands[fdfind] )); then
    target="$(fdfind --type d --hidden --exclude .git . | fzf --height=45% --reverse --no-multi)" || return
  elif (( $+commands[fd] )); then
    target="$(command fd --type d --hidden --exclude .git . | fzf --height=45% --reverse --no-multi)" || return
  else
    print -u2 "fd/fdfind não encontrado"; return 127
  fi
  [[ -n "$target" ]] && cd -- "$target"
}
function fh() {
  local selection
  selection="$(fc -l -n -r 1 | fzf --height=50% --reverse --no-multi)" || return
  [[ -n "$selection" ]] && print -z -- "$selection"
}
function gproject() { gcloud config get-value project 2>/dev/null; }
function gset() {
  if (( $# != 1 )); then print -u2 'Uso: gset PROJECT_ID'; return 2; fi
  gcloud config set project "$1"
}
function wrdev() { pnpm exec wrangler dev "$@"; }
function wrdeploy() { pnpm exec wrangler deploy "$@"; }

# Fast directory-jumping; 'j photo' jumps to frequently visited paths.
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh --cmd j)"
fi

# fzf's standard Ctrl+R and Ctrl+T work with compatible hardware keyboards.
if (( $+commands[fzf] )) && fzf --zsh >/dev/null 2>&1; then
  eval "$(fzf --zsh)"
fi

