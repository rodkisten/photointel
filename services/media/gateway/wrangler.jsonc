{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "photointel-media",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "routes": [{ "pattern": "media.migos.club", "custom_domain": true }],
  "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "photointel" }],
  "vars": { "MEDIA_PREFIX": "derived/" }
}
