{
  "project_id": "replace-project-id",
  "region": "us-central1",
  "repository": "photointel",
  "image": "us-central1-docker.pkg.dev/replace-project-id/photointel/api:REPLACE_GIT_SHA",
  "frontend_origin": "https://photos.example.com",
  "api_origin": "https://photos.example.com",
  "access_team_domain": "replace-team.cloudflareaccess.com",
  "access_audience": "REPLACE_ACCESS_AUDIENCE",
  "access_allowed_emails": [
    "replace@example.com"
  ],
  "storage_endpoint": "https://REPLACE_ACCOUNT.r2.cloudflarestorage.com",
  "storage_bucket": "photointel-private",
  "enable_icloud": false,
  "enable_gpu": false,
  "icloud_account": "",
  "icloud_library": "",
  "api_max_instances": 3,
  "api_concurrency": 8,
  "api_timeout_seconds": 300,
  "job_task_count": 1,
  "job_parallelism": 1,
  "job_max_jobs": 100,
  "job_deadline_seconds": 2400,
  "job_timeout_seconds": 2700,
  "scheduler_timezone": "Etc/UTC",
  "auto_resume_schedules": false,
  "discovery_schedule": "0 * * * *",
  "worker_schedule": "*/10 * * * *",
  "maintenance_schedule": "17 */6 * * *",
  "database_profile": "limited",
  "database_catalog_limit": 1000,
  "secrets": {
    "DATABASE_URL": {
      "name": "photointel-database-url",
      "version": "1"
    },
    "MIGRATION_DATABASE_URL": {
      "name": "photointel-migration-database-url",
      "version": "1"
    },
    "STORAGE_ACCESS_KEY": {
      "name": "photointel-r2-access-key",
      "version": "1"
    },
    "STORAGE_SECRET_KEY": {
      "name": "photointel-r2-secret-key",
      "version": "1"
    },
    "BRIDGE_TOKEN_PEPPER": {
      "name": "photointel-bridge-pepper",
      "version": "1"
    },
    "BRIDGE_ENROLLMENT_SECRET": {
      "name": "photointel-bridge-enrollment",
      "version": "1"
    },
    "ICLOUD_SESSION_KEY": {
      "name": "photointel-session-aead-key",
      "version": "1"
    }
  },
  "extra_environment": {},
  "workflows": {
    "worker": {
      "name": "photointel",
      "domain": "photos.example.com"
    }
  },
  "workflow_secrets": {
    "CLOUDFLARE_API_TOKEN": {
      "name": "photointel-pages-token",
      "version": "1"
    },
    "CLOUDFLARE_ACCOUNT_ID": {
      "name": "photointel-cloudflare-account",
      "version": "1"
    },
    "TS_OAUTH_CLIENT_ID": {
      "name": "photointel-tailscale-client",
      "version": "1"
    },
    "TS_OAUTH_SECRET": {
      "name": "photointel-tailscale-secret",
      "version": "1"
    }
  }
}
