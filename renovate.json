{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "prConcurrentLimit": 1,
  "branchConcurrentLimit": 1,
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "lockFileMaintenance"
      ],
      "enabled": false
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "all minor dependency updates",
      "groupSlug": "all-minor-dependencies",
      "automerge": true
    }
  ]
}
