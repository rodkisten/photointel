# Local Cloudflare relay deployment configuration.
infra/cloudflare/cloud-run-proxy/wrangler.toml
infra/cloudflare/cloud-run-proxy/.wrangler/

# GCP_CONFIG_ENV generates these local, non-committable release artifacts.
# They must not make the checkout dirty before release-manifest.py runs.
infra/gcp/config.local.json
infra/gcp/rendered/
infra/gcp/state/

# Private local deployment diagnostics and logs.
.photointel-reports/

# Generated release parameters and declarative adoption; never commit local plans.
infra/terraform/environments/production/media-release.auto.tfvars.json
infra/terraform/environments/production/media-imports.auto.tf.json
infra/terraform/environments/production/tfplan
infra/terraform/**/.terraform/

# Secret-free adoption metadata is private runtime config, not source.
infra/terraform/environments/production/api-release.auto.tfvars.json
infra/terraform/environments/production/api-imports.auto.tf.json
infra/terraform/environments/cloudflare/adoption.auto.tf.json
infra/terraform/environments/cloudflare/inventory.auto.tfvars.json
infra/terraform/environments/cloudflare/tfplan
