# Copie com `make setup`; o script gera credenciais locais aleatórias em .env.
COMPOSE_PROJECT_NAME=photointel
APP_ENV=development
AUTH_MODE=local
LOG_LEVEL=INFO
LOCAL_IDENTITY_EMAIL=local@photointel.invalid
FRONTEND_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8000
POSTGRES_USER=photointel
POSTGRES_DB=photointel
POSTGRES_PASSWORD=GENERATE_WITH_MAKE_SETUP
POSTGRES_APP_USER=photointel_app
POSTGRES_APP_PASSWORD=GENERATE_WITH_MAKE_SETUP
APP_DATABASE_URL=GENERATE_WITH_MAKE_SETUP
MIGRATION_DATABASE_URL=
DATABASE_URL=postgresql+asyncpg://photointel:GENERATE_WITH_MAKE_SETUP@localhost:5432/photointel
MINIO_ROOT_USER=photointel-local
MINIO_ROOT_PASSWORD=GENERATE_WITH_MAKE_SETUP
STORAGE_BACKEND=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=photointel-private
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=photointel-local
STORAGE_SECRET_KEY=GENERATE_WITH_MAKE_SETUP
STORAGE_LOCAL_DIRECTORY=var/media
SIGNED_URL_SECONDS=60
MEDIA_MAX_BYTES=20971520
# Dimensões máximas preservam proporção; derivados não carregam EXIF/GPS.
THUMBNAIL_SMALL_SIZE=240
THUMBNAIL_MEDIUM_SIZE=640
PREVIEW_LARGE_SIZE=1600
INFERENCE_INPUT_SIZE=512
IMAGE_QUALITY=85
TEMP_DIRECTORY=var/processing
TEMPORARY_RETENTION_HOURS=24
ICLOUD_ENABLED=false
ICLOUD_ACCOUNT=
ICLOUD_LIBRARY=PrimarySync
ICLOUD_SESSION_DIRECTORY=var/icloud-session
ICLOUD_DOWNLOAD_DIRECTORY=var/icloud-downloads
INGESTION_INTERVAL_MINUTES=60
INGESTION_IMPORT_LIMIT=100
DOWNLOAD_REPRESENTATION=medium
ALLOW_ORIGINAL_FALLBACK=false
MAX_DOWNLOAD_BYTES=20971520
MAX_RUN_DOWNLOAD_BYTES=2097152000
RECONCILE_MISSING_SCANS=3
BATCH_SIZE=8
WORKER_CONCURRENCY=1
JOB_LEASE_SECONDS=300
JOB_HEARTBEAT_SECONDS=20
JOB_POLL_SECONDS=2
GPU_ENABLED=false
INFERENCE_BACKEND=modal
MODAL_ENDPOINT=
MODAL_TOKEN=
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=
MODAL_TIMEOUT_SECONDS=300
MAX_GPU_CONCURRENCY=1
GPU_MAX_ASSETS_PER_RUN=100
GPU_HOURLY_COST_ESTIMATE=0.6
GPU_ESTIMATED_SECONDS_PER_ASSET=1
GPU_MAX_COST_PER_RUN=1
GPU_DAILY_BUDGET=2
GPU_MONTHLY_BUDGET=10
JOYTAG_MODEL_ID=fancyfeast/joytag
JOYTAG_MODEL_REVISION=6b7f16331a6ccf0fdce37d5a9564715f6e772b22
JOYTAG_THRESHOLD=0.4
JOYTAG_MAX_TAGS=80
SIGLIP_MODEL_ID=google/siglip2-base-patch16-224
SIGLIP_MODEL_REVISION=75de2d55ec2d0b4efc50b3e9ad70dba96a7b2fa2
SIGLIP_EMBEDDING_DIMENSION=768
MODEL_CACHE_DIRECTORY=var/model-cache
SENSITIVE_TAGS_VISIBLE=false
BRIDGE_ENROLLMENT_SECRET=GENERATE_WITH_MAKE_SETUP
BRIDGE_TOKEN_PEPPER=GENERATE_WITH_MAKE_SETUP
APPLE_KEYWORD_SYNC_MODE=manual
APPLE_BULK_WRITE_ENABLED=false
# Produção: AUTH_MODE=cloudflare, origens HTTPS, allowlist JSON e bucket R2 privado.
ACCESS_TEAM_DOMAIN=
ACCESS_AUDIENCE=
ACCESS_ALLOWED_EMAILS=[]
ACCESS_JWKS_CACHE_SECONDS=300
CORS_ORIGINS=[]
CLOUDFLARE_TUNNEL_TOKEN=
# BuildKit usa CA normal fora do ambiente gerenciado. Neste ambiente indique
# /etc/ssl/certs/ca-certificates.crt para preservar a CA do proxy configurado.
BUILD_CA_FILE=/etc/ssl/certs/ca-certificates.crt
PHOTOINTEL_IMAGE=photointel-api:local
PHOTOINTEL_WEB_IMAGE=photointel-web:local
