{
  "project_id": "photointel",
  "region": "us-central1",
  "repository": "photointel",
  "image": "us-central1-docker.pkg.dev/photointel/photointel/api:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "release_git_sha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "frontend_origin": "https://photos.example.org",
  "api_origin": "https://api.example.org",
  "storage_endpoint": "https://storage.example.org",
  "access_team_domain": "fixture.cloudflareaccess.com",
  "access_audience": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "access_allowed_emails": [
    "one@example.org",
    "two@example.org"
  ],
  "storage_bucket": "fixture-bucket",
  "api_max_instances": 3,
  "api_concurrency": 20,
  "api_timeout_seconds": 60,
