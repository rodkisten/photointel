    "BRIDGE_ENROLLMENT_SECRET": {
      "name": "bridge-enrollment-secret",
      "version": "1"
    },
    "ICLOUD_SESSION_KEY": {
      "name": "icloud-session-key",
      "version": "1"
    },
    "NOTIFY_DEVICE_ID": {
      "name": "notify-device-id",
